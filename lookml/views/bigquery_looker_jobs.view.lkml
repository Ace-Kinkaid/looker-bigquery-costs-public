# =================================================================================================
# LOOKER & BIGQUERY COST GOVERNANCE & ATTRIBUTION DERIVED TABLE VIEW
# =================================================================================================
# View Name: bigquery_looker_jobs
# Description:
#   High-performance Persistent Derived Table (PDT) that combines raw Google Cloud BigQuery
#   execution metrics from INFORMATION_SCHEMA.JOBS_BY_PROJECT with enriched Looker System Activity
#   metadata (Users, User Groups, Roles, Dashboards, Looks, Explores, Conversational Analytics, and PDTs).
#
# Datagroup & Persistence:
#   - Refresh Trigger: bq_cost_attribution_daily_6am (refreshes daily at 6:00 AM ET)
#   - Partition Key: creation_date (90-day retention window)
#   - Cluster Keys: history_slug, job_id, looker_user_name
#
# Architecture & CTE Data Flow:
#   1. raw_jobs: Scans INFORMATION_SCHEMA.JOBS_BY_PROJECT for all QUERY jobs over the last 90 days.
#      Extracts raw regex patterns for JSON context comments (-- Looker Query Context {...}),
#      legacy context comments, and native BigQuery job labels.
#   2. extracted_jobs: Parses structured metadata tokens (history_slug, pdt_name, pdt_model_name,
#      base_user_id, base_dashboard_id, base_look_id, base_explore_name, base_model_name), determines
#      whether the query was initiated by Looker (is_looker_query_base), and applies initial query
#      source categorization (base_query_source).
#   3. history_matched_jobs: Left joins with looker_bq_costs.history lookup table on history_slug.
#      Resolves granular model_name, explore_name, query_origin_type, and finalized query_source.
#   4. parsed_jobs: Left joins with looker_bq_costs.users table on looker_user_id to resolve human-readable
#      user display names and emails.
#   5. enriched_jobs: Applies business logic for cost centers, user attribution, unified smart asset
#      naming (content_name), and calculates effective billed bytes (incorporating the 10 MB minimum rule
#      and $0 cache hits).
#
# =================================================================================================
# ATTRIBUTE CLASSIFICATION & TAXONOMY REFERENCE GUIDE
# =================================================================================================
#
# 1. QUERY SOURCE (dimension: query_source)
#    Origin category identifying the specific mechanism within or outside Looker that triggered the job:
#    - conversational_analytics: Natural language queries generated by Looker Conversational Analytics / Gemini.
#    - pdt_build: Persistent Derived Table creation/rebuild jobs (destination table LR_/LC_/LD_ or PDT headers).
#    - dashboard: Interactive tile queries originating from a Looker Dashboard.
#    - look: Queries originating from a saved Looker Look.
#    - scheduled_task: Automated scheduled reports, data deliveries, and rendering jobs.
#    - alert: Automated alert threshold condition check queries.
#    - sql_runner: Ad-hoc SQL queries executed interactively within Looker SQL Runner.
#    - api: Programmatic queries executed via the Looker SDK or REST API.
#    - explore_adhoc: Interactive ad-hoc queries executed from the Looker Explore interface.
#    - direct_bigquery: Queries executed directly in BigQuery without Looker UI context headers (includes
#      automated background connection heartbeats and direct GCP console queries).
#
# 2. QUERY ORIGIN TYPE (dimension: query_origin_type)
#    High-level operational classification for executive rollups and spend velocity analysis:
#    - Conversational Analytics: AI-assisted natural language exploration and answers.
#    - Looker PDT Build: Background infrastructure data transformation pipelines.
#    - Looker Dashboard: User consumption of pinned BI dashboards.
#    - Looker Look: Saved user reports and visualizations.
#    - Looker SQL Runner: Developer and analyst raw SQL exploration.
#    - Looker Explore Query: Self-service business data exploration.
#    - Looker Platform Maintenance: Low-level dialect connection liveness checks, table registration,
#      and metadata discovery executed by Looker's backend database connector.
#    - External Data Pipeline: Automated ETL/ELT data pipelines executing under non-Looker service accounts.
#    - Direct BigQuery (Human User): Ad-hoc interactive SQL executed in the BigQuery Cloud Console.
#
# 3. MODEL NAME & EXPLORE NAME RESOLUTION HIERARCHY
#    - Priority 1: Conversational Analytics source (Conversational Analytics / Conversational Analytics Query)
#    - Priority 2: System Activity History Table (h.query_model / h.query_explore)
#    - Priority 3: Injected Looker Context JSON / Labels (e.base_model_name / e.base_explore_name)
#    - Priority 4: PDT Model / PDT View Name (PDT: <model> / PDT Build: <view_name>)
#    - Priority 5: SQL Runner context (Looker SQL Runner / SQL Runner Ad-hoc SQL)
#    - Priority 6: Ad-hoc Explore session (Looker Ad-hoc Explore / Looker Ad-hoc Query)
#    - Priority 7: Looker System Connection Checks (Looker Platform System / Connection Heartbeat & Metadata)
#    - Priority 8: External Service Accounts (External Data Pipeline / Pipeline: <service_account_prefix>)
#    - Priority 9: Direct BigQuery Console (Direct BigQuery Console / Direct User SQL (<user_email>))
#
# 4. COST CENTER ALLOCATION (dimension: cost_center)
#    - Conversational Analytics: BigQuery consumption driven by Conversational Analytics and Gemini in Looker.
#    - Shared Infrastructure / Looker PDTs: All PDT background rebuilds and scratch table management.
#    - Business Teams: Queries initiated by identified Looker business users (dashboards, looks, explores).
#    - Shared / Looker System: Automated Looker background tasks without direct named user attribution.
#    - Non-Looker / Direct BigQuery: Queries executed outside of the Looker platform.
#
# =================================================================================================

view: bigquery_looker_jobs {
  derived_table: {
    datagroup_trigger: bq_cost_attribution_daily_6am
    partition_keys: ["creation_date"]
    cluster_keys: ["history_slug", "job_id", "looker_user_name"]
    sql:
      WITH raw_jobs AS (
        -- Step 1: Scan INFORMATION_SCHEMA.JOBS_BY_PROJECT for QUERY jobs over the last 90 days
        SELECT
          job_id,
          project_id,
          user_email AS bq_executing_account,
          creation_time,
          DATE(creation_time) AS creation_date,
          start_time,
          end_time,
          TIMESTAMP_DIFF(end_time, start_time, MILLISECOND) / 1000.0 AS runtime_seconds,
          total_bytes_billed,
          total_bytes_processed,
          total_slot_ms,
          cache_hit,
          query,
          error_result.reason AS error_reason,
          error_result.message AS error_message,
          labels,
          destination_table.dataset_id AS dest_dataset_id,
          destination_table.table_id AS dest_table_id,
          statement_type,
          -- Extract JSON context block: -- Looker Query Context {"..."} or /* Looker Query Context {"..."} */
          REGEXP_EXTRACT(query, r"(?s)(?:--|/\*)\s*Looker Query Context\s*\'?(\{.*?\})\'?") AS looker_json_context,
          -- Extract legacy comment format: -- Looker Query Context (User ID: 123, ...)
          REGEXP_EXTRACT(query, r"(?s)-- Looker Query Context \((.*?)\)") AS looker_legacy_context
        FROM
          `@{GCP_PROJECT_ID}`.`region-@{BQ_REGION}`.INFORMATION_SCHEMA.JOBS_BY_PROJECT
        WHERE
          job_type = 'QUERY'
          AND creation_time >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 90 DAY)
      ),

      extracted_jobs AS (
        -- Step 2: Parse tokens and establish baseline source classifications
        SELECT
          r.job_id,
          r.project_id,
          r.bq_executing_account,
          r.creation_time,
          r.creation_date,
          r.start_time,
          r.end_time,
          r.runtime_seconds,
          r.total_bytes_billed,
          r.total_bytes_processed,
          r.total_slot_ms,
          r.cache_hit,
          r.query,
          r.error_reason,
          r.error_message,
          r.labels,
          r.statement_type,
          r.looker_json_context,
          r.looker_legacy_context,
          r.dest_dataset_id,
          r.dest_table_id,

          -- Extract history slug token (links BigQuery jobs to Looker System Activity history table)
          COALESCE(
            JSON_VALUE(r.looker_json_context, '$.history_slug'),
            JSON_VALUE(r.looker_json_context, '$.slug'),
            (SELECT value FROM UNNEST(r.labels) WHERE key = 'looker-context-history_slug'),
            REGEXP_EXTRACT(r.looker_legacy_context, r"(?i)History Slug:\s*([^\s,;]+)")
          ) AS history_slug,

          -- Extract PDT View Name from comments, labels, or destination scratch table names
          COALESCE(
            JSON_VALUE(r.looker_json_context, '$.pdt_name'),
            JSON_VALUE(r.looker_json_context, '$.pdt_view'),
            (SELECT value FROM UNNEST(r.labels) WHERE key = 'looker-context-pdt_name'),
            REGEXP_EXTRACT(r.looker_legacy_context, r"(?i)pdt_name:\s*([^\s,;]+)"),
            IF(r.query LIKE '-- Building persistent derived table%' OR r.query LIKE '--  Building persistent derived table%', REGEXP_EXTRACT(r.query, r"(?i)--\s*Building persistent derived table [^:]+::([^\s]+)"), NULL),
            IF(r.query LIKE '-- Building persistent derived table%' OR r.query LIKE '--  Building persistent derived table%', REGEXP_EXTRACT(r.query, r"(?i)--\s*Building persistent derived table ([^\s]+)"), NULL),
            IF(r.dest_table_id LIKE 'LR_%' OR r.dest_table_id LIKE 'LR$%' OR r.dest_table_id LIKE 'LC_%' OR r.dest_table_id LIKE 'LC$%' OR r.dest_table_id LIKE 'LD_%' OR r.dest_table_id LIKE 'LD$%', REGEXP_EXTRACT(r.dest_table_id, r"(?i)L[RCD][\$_][0-9a-zA-Z]+_(.+)"), NULL),
            IF(r.dest_table_id LIKE 'LR_%' OR r.dest_table_id LIKE 'LR$%' OR r.dest_table_id LIKE 'LC_%' OR r.dest_table_id LIKE 'LC$%' OR r.dest_table_id LIKE 'LD_%' OR r.dest_table_id LIKE 'LD$%', REGEXP_EXTRACT(r.dest_table_id, r"(?i)L[RCD][\$_]([0-9a-zA-Z_]+)"), NULL)
          ) AS pdt_name,

          -- Extract PDT Model Name from query comments or context JSON
          COALESCE(
            IF(r.query LIKE '-- Building persistent derived table%' OR r.query LIKE '--  Building persistent derived table%', REGEXP_EXTRACT(r.query, r"(?i)--\s*Building persistent derived table ([^:]+)::"), NULL),
            JSON_VALUE(r.looker_json_context, '$.model'),
            JSON_VALUE(r.looker_json_context, '$.model_name')
          ) AS pdt_model_name,

          -- Base extraction for Looker User ID
          COALESCE(
            SAFE_CAST(JSON_VALUE(r.looker_json_context, '$.user_id') AS INT64),
            SAFE_CAST((SELECT value FROM UNNEST(r.labels) WHERE key = 'looker-context-user_id') AS INT64),
            SAFE_CAST(REGEXP_EXTRACT(r.looker_legacy_context, r"(?i)User ID:\s*(\\d+)") AS INT64)
          ) AS base_user_id,

          -- Base extraction for Dashboard ID & Title
          COALESCE(
            JSON_VALUE(r.looker_json_context, '$.dashboard_id'),
            (SELECT value FROM UNNEST(r.labels) WHERE key = 'looker-context-dashboard_id'),
            REGEXP_EXTRACT(r.looker_legacy_context, r"(?i)Dashboard ID:\s*([^\s,;]+)")
          ) AS base_dashboard_id,

          COALESCE(
            JSON_VALUE(r.looker_json_context, '$.dashboard_title'),
            (SELECT value FROM UNNEST(r.labels) WHERE key = 'looker-context-dashboard_title')
          ) AS base_dashboard_title,

          -- Base extraction for Look ID & Title
          COALESCE(
            SAFE_CAST(JSON_VALUE(r.looker_json_context, '$.look_id') AS INT64),
            SAFE_CAST((SELECT value FROM UNNEST(r.labels) WHERE key = 'looker-context-look_id') AS INT64),
            SAFE_CAST(REGEXP_EXTRACT(r.looker_legacy_context, r"(?i)Look ID:\s*(\\d+)") AS INT64)
          ) AS base_look_id,

          COALESCE(
            JSON_VALUE(r.looker_json_context, '$.look_title'),
            (SELECT value FROM UNNEST(r.labels) WHERE key = 'looker-context-look_title')
          ) AS base_look_title,

          -- Base extraction for Explore and Model
          COALESCE(
            JSON_VALUE(r.looker_json_context, '$.explore'),
            JSON_VALUE(r.looker_json_context, '$.explore_name'),
            (SELECT value FROM UNNEST(r.labels) WHERE key = 'looker-context-explore')
          ) AS base_explore_name,

          COALESCE(
            JSON_VALUE(r.looker_json_context, '$.model'),
            JSON_VALUE(r.looker_json_context, '$.model_name'),
            (SELECT value FROM UNNEST(r.labels) WHERE key = 'looker-context-model')
          ) AS base_model_name,

          -- Identify whether query originated from the Looker platform
          CASE
            WHEN r.looker_json_context IS NOT NULL OR r.looker_legacy_context IS NOT NULL THEN TRUE
            WHEN EXISTS (SELECT 1 FROM UNNEST(r.labels) l WHERE l.key LIKE 'looker%') THEN TRUE
            WHEN r.dest_table_id LIKE 'LR_%' OR r.dest_table_id LIKE 'LR$%'
              OR r.dest_table_id LIKE 'LC_%' OR r.dest_table_id LIKE 'LC$%'
              OR r.dest_table_id LIKE 'LD_%' OR r.dest_table_id LIKE 'LD$%' THEN TRUE
            WHEN r.dest_dataset_id LIKE '%scratch%' THEN TRUE
            WHEN r.bq_executing_account LIKE '%looker%' THEN TRUE
            WHEN r.query LIKE '-- Looker%' OR r.query LIKE '/* Looker%' OR r.query LIKE '-- Building persistent derived table%' THEN TRUE
            ELSE FALSE
          END AS is_looker_query_base,

          -- Comprehensive Base Query Source Detection
          CASE
            -- 1. Conversational Analytics / Gemini in Looker / Explore Assistant
            WHEN JSON_VALUE(r.looker_json_context, '$.source') IN ('conversational_analytics', 'conversational', 'explore_assistant', 'gemini', 'duet_ai', 'nl_query')
              OR EXISTS (SELECT 1 FROM UNNEST(r.labels) l WHERE l.key = 'looker-context-source' AND l.value IN ('conversational_analytics', 'conversational', 'explore_assistant', 'gemini', 'duet_ai', 'nl_query'))
              OR EXISTS (SELECT 1 FROM UNNEST(r.labels) l WHERE l.key LIKE 'looker-context-conversational%')
              OR r.looker_legacy_context LIKE '%conversational%'
              OR r.query LIKE '%Conversational Analytics%'
              OR r.query LIKE '%explore_assistant%'
              THEN 'conversational_analytics'

            -- 2. True Looker PDT Build Indicators
            WHEN JSON_VALUE(r.looker_json_context, '$.source') IN ('pdt', 'pdt_regenerator', 'pdt_build')
              OR JSON_VALUE(r.looker_json_context, '$.pdt') = 'true'
              OR JSON_VALUE(r.looker_json_context, '$.pdt_name') IS NOT NULL
              OR EXISTS (SELECT 1 FROM UNNEST(r.labels) l WHERE l.key = 'looker-context-source' AND l.value = 'pdt')
              OR EXISTS (SELECT 1 FROM UNNEST(r.labels) l WHERE l.key = 'looker-context-pdt_name')
              OR r.looker_legacy_context LIKE '%PDT Event:%'
              OR r.looker_legacy_context LIKE '%pdt_name:%'
              OR r.query LIKE '-- Building persistent derived table%'
              OR r.dest_table_id LIKE 'LR_%' OR r.dest_table_id LIKE 'LR$%'
              OR r.dest_table_id LIKE 'LC_%' OR r.dest_table_id LIKE 'LC$%'
              OR r.dest_table_id LIKE 'LD_%' OR r.dest_table_id LIKE 'LD$%'
              OR (r.dest_dataset_id LIKE '%scratch%' AND r.query NOT LIKE '%connection_reg_r3%' AND r.query NOT LIKE '%INFORMATION_SCHEMA.PROPERTY_GRAPHS%')
              THEN 'pdt_build'

            -- 3. Dashboards
            WHEN JSON_VALUE(r.looker_json_context, '$.dashboard_id') IS NOT NULL
              OR EXISTS (SELECT 1 FROM UNNEST(r.labels) l WHERE l.key = 'looker-context-dashboard_id')
              THEN 'dashboard'

            -- 4. Looks
            WHEN JSON_VALUE(r.looker_json_context, '$.look_id') IS NOT NULL
              OR EXISTS (SELECT 1 FROM UNNEST(r.labels) l WHERE l.key = 'looker-context-look_id')
              THEN 'look'

            -- 5. Scheduled Tasks & Data Delivery
            WHEN JSON_VALUE(r.looker_json_context, '$.source') IN ('scheduled_task', 'scheduled_plan', 'schedule', 'render_task', 'action')
              OR EXISTS (SELECT 1 FROM UNNEST(r.labels) l WHERE l.key = 'looker-context-source' AND l.value IN ('scheduled_task', 'scheduled_plan', 'schedule'))
              THEN 'scheduled_task'

            -- 6. Alerts
            WHEN JSON_VALUE(r.looker_json_context, '$.source') = 'alert'
              OR EXISTS (SELECT 1 FROM UNNEST(r.labels) l WHERE l.key = 'looker-context-source' AND l.value = 'alert')
              THEN 'alert'

            -- 7. SQL Runner
            WHEN JSON_VALUE(r.looker_json_context, '$.source') = 'sql_runner'
              OR EXISTS (SELECT 1 FROM UNNEST(r.labels) l WHERE l.key = 'looker-context-source' AND l.value = 'sql_runner')
              THEN 'sql_runner'

            -- 8. API / SDK
            WHEN JSON_VALUE(r.looker_json_context, '$.source') = 'api'
              OR EXISTS (SELECT 1 FROM UNNEST(r.labels) l WHERE l.key = 'looker-context-source' AND l.value = 'api')
              THEN 'api'

            -- 9. Ad-hoc Explore Queries (has Looker UI context comments or session labels)
            WHEN r.looker_json_context IS NOT NULL
              OR r.looker_legacy_context IS NOT NULL
              OR EXISTS (SELECT 1 FROM UNNEST(r.labels) l WHERE l.key LIKE 'looker%')
              THEN 'explore_adhoc'

            -- 10. Non-Looker Direct BigQuery / Connection Heartbeats without UI headers
            ELSE 'direct_bigquery'
          END AS base_query_source
        FROM raw_jobs r
      ),

      history_matched_jobs AS (
        -- Step 3: Enrich with Looker System Activity history table
        SELECT
          e.*,
          h.history_id,
          h.query_id,
          COALESCE(h.user_id, e.base_user_id) AS looker_user_id,
          COALESCE(CAST(h.dashboard_id AS STRING), e.base_dashboard_id) AS dashboard_id,
          COALESCE(h.dashboard_title, e.base_dashboard_title) AS raw_dashboard_title,
          e.base_look_id AS look_id,
          e.base_look_title AS raw_look_title,
          h.source AS history_source,
          h.api_client_name,
          h.agent_name,
          h.ca_agent_id,
          h.ca_conversation_id,

          -- Granular Model Name resolution hierarchy
          CASE
            WHEN e.base_query_source = 'conversational_analytics'
              OR h.api_client_name = 'Conversational Analytics'
              OR h.agent_name IS NOT NULL
              OR h.ca_agent_id IS NOT NULL
              THEN COALESCE(h.query_model, e.base_model_name, 'Conversational Analytics')
            WHEN h.query_model IS NOT NULL THEN h.query_model
            WHEN e.base_model_name IS NOT NULL THEN e.base_model_name
            WHEN e.base_query_source = 'pdt_build' AND e.pdt_model_name IS NOT NULL THEN CONCAT('PDT: ', e.pdt_model_name)
            WHEN e.base_query_source = 'pdt_build' THEN 'Looker PDT Pipeline'
            WHEN e.base_query_source = 'sql_runner' THEN 'Looker SQL Runner'
            WHEN e.base_query_source = 'explore_adhoc' THEN 'Looker Ad-hoc Explore'
            WHEN e.is_looker_query_base THEN 'Looker Platform System'
            WHEN e.bq_executing_account LIKE '%.gserviceaccount.com' THEN 'External Data Pipeline'
            ELSE 'Direct BigQuery Console'
          END AS model_name,

          -- Granular Explore Name resolution hierarchy
          CASE
            WHEN e.base_query_source = 'conversational_analytics'
              OR h.api_client_name = 'Conversational Analytics'
              OR h.agent_name IS NOT NULL
              OR h.ca_agent_id IS NOT NULL
              THEN COALESCE(h.query_explore, e.base_explore_name, 'Conversational Analytics Query')
            WHEN h.query_explore IS NOT NULL THEN h.query_explore
            WHEN e.base_explore_name IS NOT NULL THEN e.base_explore_name
            WHEN e.base_query_source = 'pdt_build' AND e.pdt_name IS NOT NULL THEN CONCAT('PDT Build: ', e.pdt_name)
            WHEN e.base_query_source = 'pdt_build' THEN 'PDT Scratch Table Build'
            WHEN e.base_query_source = 'sql_runner' THEN 'SQL Runner Ad-hoc SQL'
            WHEN e.base_query_source = 'explore_adhoc' THEN 'Looker Ad-hoc Query'
            WHEN e.is_looker_query_base THEN 'Connection Heartbeat & Metadata'
            WHEN e.bq_executing_account LIKE '%.gserviceaccount.com' THEN CONCAT('Pipeline: ', SPLIT(e.bq_executing_account, '@')[OFFSET(0)])
            ELSE CONCAT('Direct User SQL (', e.bq_executing_account, ')')
          END AS explore_name,

          -- High-level Query Origin Category for executive rollups
          CASE
            WHEN e.base_query_source = 'conversational_analytics'
              OR h.api_client_name = 'Conversational Analytics'
              OR h.agent_name IS NOT NULL
              OR h.ca_agent_id IS NOT NULL
              THEN 'Conversational Analytics'
            WHEN e.base_query_source = 'pdt_build' THEN 'Looker PDT Build'
            WHEN h.dashboard_id IS NOT NULL OR e.base_dashboard_id IS NOT NULL THEN 'Looker Dashboard'
            WHEN e.base_look_id IS NOT NULL THEN 'Looker Look'
            WHEN e.base_query_source = 'sql_runner' THEN 'Looker SQL Runner'
            WHEN h.query_explore IS NOT NULL OR e.base_explore_name IS NOT NULL OR e.base_query_source = 'explore_adhoc' THEN 'Looker Explore Query'
            WHEN e.is_looker_query_base THEN 'Looker Platform Maintenance'
            WHEN e.bq_executing_account LIKE '%.gserviceaccount.com' THEN 'External Data Pipeline'
            ELSE 'Direct BigQuery (Human User)'
          END AS query_origin_type,

          CASE
            WHEN e.base_query_source = 'conversational_analytics' THEN TRUE
            WHEN h.api_client_name = 'Conversational Analytics' OR h.agent_name IS NOT NULL OR h.ca_agent_id IS NOT NULL THEN TRUE
            WHEN e.base_query_source = 'pdt_build' THEN TRUE
            WHEN h.history_id IS NOT NULL THEN TRUE
            ELSE e.is_looker_query_base
          END AS is_looker_query,

          -- Final Query Source resolution
          CASE
            WHEN e.base_query_source = 'conversational_analytics'
              OR h.api_client_name = 'Conversational Analytics'
              OR h.agent_name IS NOT NULL
              OR h.ca_agent_id IS NOT NULL
              OR (h.source = 'api4' AND h.api_client_name LIKE '%Conversational%')
              THEN 'conversational_analytics'
            WHEN e.base_query_source = 'pdt_build' THEN 'pdt_build'
            WHEN h.dashboard_id IS NOT NULL OR e.base_dashboard_id IS NOT NULL THEN 'dashboard'
            WHEN e.base_look_id IS NOT NULL THEN 'look'
            WHEN h.query_explore IS NOT NULL OR e.base_explore_name IS NOT NULL THEN 'explore_adhoc'
            ELSE e.base_query_source
          END AS query_source
        FROM extracted_jobs e
        LEFT JOIN `@{GCP_PROJECT_ID}`.@{BQ_DATASET_NAME}.history h
          ON e.history_slug IS NOT NULL
          AND e.history_slug = h.history_slug
      ),

      parsed_jobs AS (
        -- Step 4: Resolve human-readable user names and emails from looker_bq_costs.users
        SELECT
          hm.*,
          COALESCE(
            JSON_VALUE(hm.looker_json_context, '$.user_name'),
            u.user_name,
            (SELECT value FROM UNNEST(hm.labels) WHERE key = 'looker-context-user_name'),
            IF(hm.looker_user_id IS NOT NULL, CONCAT('Looker User #', CAST(hm.looker_user_id AS STRING)), NULL)
          ) AS raw_user_name,

          COALESCE(
            JSON_VALUE(hm.looker_json_context, '$.user_email'),
            u.user_email,
            (SELECT value FROM UNNEST(hm.labels) WHERE key = 'looker-context-user_email'),
            IF(hm.looker_user_id IS NOT NULL, CONCAT('user_', CAST(hm.looker_user_id AS STRING), '@looker.internal'), NULL)
          ) AS raw_user_email
        FROM history_matched_jobs hm
        LEFT JOIN `@{GCP_PROJECT_ID}`.@{BQ_DATASET_NAME}.users u
          ON hm.looker_user_id = u.user_id
      ),

      enriched_jobs AS (
        -- Step 5: Assign Cost Center, Unified Asset Content Name, and Effective Billed Bytes
        SELECT
          *,
          -- Shared Cost Center Logic for Conversational Analytics, PDTs, Business Users, and System Tasks
          CASE
            WHEN query_source = 'conversational_analytics' THEN 'Conversational Analytics'
            WHEN query_source = 'pdt_build' THEN 'Shared Infrastructure / Looker PDTs'
            WHEN is_looker_query AND raw_user_name IS NOT NULL THEN 'Business Teams'
            WHEN is_looker_query THEN 'Shared / Looker System'
            ELSE 'Non-Looker / Direct BigQuery'
          END AS cost_center,

          -- User attribution with PDT background process override
          CASE
            WHEN query_source = 'conversational_analytics' THEN COALESCE(raw_user_name, 'Conversational Analytics User')
            WHEN query_source = 'pdt_build' THEN 'Looker PDT Background Process'
            WHEN raw_user_name IS NOT NULL THEN raw_user_name
            WHEN is_looker_query THEN 'Looker System / Scheduled'
            ELSE 'Direct BQ'
          END AS looker_user_name,

          -- Unified Asset Label across Dashboards, Looks, Explores, and PDTs
          CASE
            WHEN query_source = 'conversational_analytics' THEN CONCAT('Conversational Agent: ', COALESCE(agent_name, 'Conversational Analytics'))
            WHEN query_source = 'pdt_build' THEN CONCAT('PDT: ', COALESCE(pdt_name, explore_name, model_name, 'Scratch Table Build'))
            WHEN raw_dashboard_title IS NOT NULL THEN CONCAT('Dashboard: ', raw_dashboard_title)
            WHEN dashboard_id IS NOT NULL THEN CONCAT('Dashboard #', dashboard_id)
            WHEN raw_look_title IS NOT NULL THEN CONCAT('Look: ', raw_look_title)
            WHEN look_id IS NOT NULL THEN CONCAT('Look #', CAST(look_id AS STRING))
            WHEN explore_name IS NOT NULL AND explore_name != 'Ad-hoc / Direct SQL' THEN CONCAT('Explore: ', explore_name)
            WHEN query_source = 'sql_runner' THEN 'SQL Runner Query'
            ELSE 'Ad-hoc / Direct BigQuery'
          END AS content_name,

          -- Effective Billed Bytes (Enforces BigQuery 10 MB minimum rule on non-cached queries; 0 for cache hits)
          CASE
            WHEN cache_hit = TRUE THEN 0
            ELSE GREATEST(COALESCE(total_bytes_billed, 0), 10485760)
          END AS effective_bytes_billed
        FROM parsed_jobs
      )

      SELECT * FROM enriched_jobs
    ;;
  }

  # =================================================================================================
  # PARAMETERS
  # =================================================================================================
  parameter: selected_project {
    type: string
    default_value: "@{GCP_PROJECT_ID}"
    label: "Google Cloud Project ID"
    description: "Target GCP Project ID for BigQuery Information Schema analysis"
  }

  parameter: cost_per_tb_rate {
    type: number
    default_value: "6.25"
    label: "On-Demand Rate ($/TB)"
    description: "BigQuery On-Demand rate per TB in USD ($6.25 standard active rate)"
  }

  # =================================================================================================
  # DIMENSIONS
  # =================================================================================================
  dimension: job_id {
    primary_key: yes
    type: string
    sql: ${TABLE}.job_id ;;
    label: "BigQuery Job ID"
    description: "Unique BigQuery execution Job ID with direct clickable link to the Google Cloud BigQuery Console"
    link: {
      label: "View in Google Cloud BigQuery Console"
      url: "https://console.cloud.google.com/bigquery?project={{ bigquery_looker_jobs.project_id._value }}&j=bq:US:{{ value }}&page=queryhistory"
      icon_url: "https://cloud.google.com/favicon.ico"
    }
  }

  dimension: raw_query {
    type: string
    sql: ${TABLE}.query ;;
    label: "Raw SQL Query"
    description: "Full SQL statement executed in BigQuery"
  }

  dimension: history_id {
    type: number
    sql: ${TABLE}.history_id ;;
    label: "Looker History ID"
    description: "Matched execution ID from Looker System Activity history table"
  }

  dimension: query_id {
    type: number
    sql: ${TABLE}.query_id ;;
    label: "Looker Query ID"
    description: "Looker internal query ID from System Activity"
  }

  dimension: project_id {
    type: string
    sql: ${TABLE}.project_id ;;
    label: "Project ID"
    description: "GCP Project ID where the BigQuery job was executed"
  }

  dimension_group: query_time {
    type: time
    timeframes: [raw, time, date, week, month, quarter, year, day_of_week, hour_of_day]
    sql: ${TABLE}.creation_time ;;
    label: "Query Execution"
    description: "Timestamp when the BigQuery job was submitted for execution"
  }

  dimension: is_looker_query {
    type: yesno
    sql: ${TABLE}.is_looker_query ;;
    label: "Is Looker Query?"
    description: "Flags TRUE if the query originated from the Looker platform (UI, API, PDT regenerator, Conversational Analytics, or connection pool)"
  }

  dimension: cost_center {
    type: string
    sql: ${TABLE}.cost_center ;;
    label: "Cost Center"
    description: "Allocated cost center: Conversational Analytics, Business Teams, Shared Infrastructure / Looker PDTs, Shared / Looker System, or Non-Looker / Direct BigQuery"
    link: {
      label: "{% if value == 'Conversational Analytics' %}Open Conversational Analytics System Activity Dashboard{% else %}Explore Cost Center Queries{% endif %}"
      url: "{% if value == 'Conversational Analytics' %}/dashboards/system__activity::conversational_analytics{% else %}/explore/bq_cost_attribution/looker_cost_analytics?fields=bigquery_looker_jobs.job_id,bigquery_looker_jobs.looker_user_name,bigquery_looker_jobs.content_name,bigquery_looker_jobs.total_cost&f[bigquery_looker_jobs.cost_center]={{ value | encode_url }}{% endif %}"
      icon_url: "{% if value == 'Conversational Analytics' %}https://cloud.google.com/favicon.ico{% else %}https://looker.com/favicon.ico{% endif %}"
    }
    drill_fields: [job_id, looker_user_name, content_name, query_source, query_time_time, total_cost]
  }

  dimension: content_name {
    type: string
    sql: ${TABLE}.content_name ;;
    label: "Content / Asset Name"
    description: "Unified display name across Dashboards, Looks, Explores, PDTs, Conversational Analytics, and Direct SQL"
    link: {
      label: "Open Dashboard / Content in Looker"
      url: "{% if bigquery_looker_jobs.dashboard_id._value != null and bigquery_looker_jobs.dashboard_id._value != '' %}/dashboards/{{ bigquery_looker_jobs.dashboard_id._value }}{% elsif bigquery_looker_jobs.look_id._value != null %}/looks/{{ bigquery_looker_jobs.look_id._value }}{% elsif bigquery_looker_jobs.explore_name._value != null and bigquery_looker_jobs.model_name._value != null and bigquery_looker_jobs.explore_name._value != 'Ad-hoc / Direct SQL' %}/explore/{{ bigquery_looker_jobs.model_name._value }}/{{ bigquery_looker_jobs.explore_name._value }}{% else %}#noop{% endif %}"
      icon_url: "https://looker.com/favicon.ico"
    }
    drill_fields: [job_id, looker_user_name, query_source, query_time_time, total_cost]
  }

  dimension: pdt_name {
    type: string
    sql: ${TABLE}.pdt_name ;;
    label: "PDT Name"
    description: "LookML view name of the Persistent Derived Table"
  }

  dimension: conversational_agent_name {
    type: string
    sql: ${TABLE}.agent_name ;;
    label: "Conversational Agent Name"
    description: "Name of the Looker Conversational Analytics Agent (e.g., Monday Morning Report, Tyson Foods Marketing Insights Agent)"
    drill_fields: [job_id, looker_user_name, content_name, query_time_time, total_cost]
  }

  dimension: api_client_name {
    type: string
    sql: ${TABLE}.api_client_name ;;
    label: "API Client Application"
    description: "Client application identifier (e.g., Conversational Analytics, MCP Toolbox, Connected Sheets, Power BI)"
  }

  dimension: ca_agent_id {
    type: string
    sql: ${TABLE}.ca_agent_id ;;
    label: "CA Agent ID"
    hidden: yes
    description: "Conversational Analytics Agent UUID"
  }

  dimension: ca_conversation_id {
    type: string
    sql: ${TABLE}.ca_conversation_id ;;
    label: "CA Conversation ID"
    hidden: yes
    description: "Conversational Analytics Conversation Session UUID"
  }

  dimension: looker_user_id {
    type: number
    sql: ${TABLE}.looker_user_id ;;
    label: "Looker User ID"
    description: "Numerical identifier of the Looker user from System Activity"
  }

  dimension: looker_user_name {
    type: string
    sql: ${TABLE}.looker_user_name ;;
    label: "User Name"
    description: "Name of the Looker user, PDT background process, or system process executing the job, or 'Direct BQ' for non-Looker jobs"
    suggest_persist_for: "0 seconds"
    suggest_dimension: bigquery_looker_jobs.looker_only_user_name
    drill_fields: [content_name, dashboard_title, look_title, explore_name, query_time_date, total_cost]
  }

  dimension: looker_only_user_name {
    hidden: yes
    type: string
    sql: CASE WHEN ${TABLE}.is_looker_query THEN ${TABLE}.looker_user_name ELSE NULL END ;;
  }

  dimension: looker_user_email {
    type: string
    sql: ${TABLE}.raw_user_email ;;
    label: "User Email"
    description: "Email address of the querying user"
  }

  dimension: bq_executing_account {
    type: string
    sql: ${TABLE}.bq_executing_account ;;
    label: "BigQuery Service Account"
    description: "The GCP service account or user account under which BigQuery executed the job"
  }

  dimension: dashboard_id {
    type: string
    sql: ${TABLE}.dashboard_id ;;
    label: "Dashboard ID"
    description: "User-defined or LookML dashboard identifier"
    link: {
      label: "Open Dashboard in Looker"
      url: "/dashboards/{{ value }}"
      icon_url: "https://looker.com/favicon.ico"
    }
  }

  dimension: dashboard_title {
    type: string
    sql: CASE
      WHEN ${TABLE}.raw_dashboard_title IS NOT NULL THEN ${TABLE}.raw_dashboard_title
      WHEN ${TABLE}.dashboard_id IS NOT NULL THEN CONCAT('Dashboard #', ${TABLE}.dashboard_id)
      ELSE 'Ad-hoc / Non-Dashboard'
    END ;;
    label: "Dashboard Title"
    link: {
      label: "Open Dashboard in Looker"
      url: "{% if bigquery_looker_jobs.dashboard_id._value != null and bigquery_looker_jobs.dashboard_id._value != '' %}/dashboards/{{ bigquery_looker_jobs.dashboard_id._value }}{% else %}#noop{% endif %}"
      icon_url: "https://looker.com/favicon.ico"
    }
    drill_fields: [looker_user_name, query_source, query_time_time, total_cost, total_terabytes_billed]
  }

  dimension: look_id {
    type: number
    sql: ${TABLE}.look_id ;;
    label: "Look ID"
    link: {
      label: "Open Look in Looker"
      url: "/looks/{{ value }}"
      icon_url: "https://looker.com/favicon.ico"
    }
  }

  dimension: look_title {
    type: string
    sql: CASE
      WHEN ${TABLE}.raw_look_title IS NOT NULL THEN ${TABLE}.raw_look_title
      WHEN ${TABLE}.look_id IS NOT NULL THEN CONCAT('Look #', CAST(${TABLE}.look_id AS STRING))
      ELSE 'Ad-hoc / Non-Look'
    END ;;
    label: "Look Title"
    link: {
      label: "Open Look in Looker"
      url: "{% if bigquery_looker_jobs.look_id._value != null %}/looks/{{ bigquery_looker_jobs.look_id._value }}{% else %}#noop{% endif %}"
      icon_url: "https://looker.com/favicon.ico"
    }
    drill_fields: [looker_user_name, query_source, query_time_time, total_cost]
  }

  dimension: query_origin_type {
    type: string
    sql: ${TABLE}.query_origin_type ;;
    label: "Query Origin Type"
    description: "High-level operational category: Conversational Analytics, Looker Dashboard, Look, Explore, PDT Build, SQL Runner, Platform Maintenance, Direct BigQuery Console, External Pipeline"
    drill_fields: [model_name, explore_name, looker_user_name, query_source, total_cost, query_count]
  }

  dimension: explore_name {
    type: string
    sql: ${TABLE}.explore_name ;;
    label: "Explore / Query Asset"
    description: "LookML Explore name, PDT build name, or specific execution asset"
    link: {
      label: "Open Explore in Looker"
      url: "{% if bigquery_looker_jobs.model_name._value != null and bigquery_looker_jobs.model_name._value != 'Looker Platform System' and bigquery_looker_jobs.model_name._value != 'Direct BigQuery Console' and bigquery_looker_jobs.model_name._value != 'External Data Pipeline' and bigquery_looker_jobs.model_name._value != 'Conversational Analytics' %}/explore/{{ bigquery_looker_jobs.model_name._value }}/{{ value }}{% else %}#noop{% endif %}"
      icon_url: "https://looker.com/favicon.ico"
    }
  }

  dimension: model_name {
    type: string
    sql: ${TABLE}.model_name ;;
    label: "Model / Execution Domain"
    description: "LookML Model name, PDT domain, Conversational Analytics, Platform System, or Direct BigQuery Console"
  }

  dimension: query_source {
    type: string
    sql: ${TABLE}.query_source ;;
    label: "Query Source"
    description: "Granular origin: conversational_analytics, dashboard, look, explore_adhoc, pdt_build, scheduled_task, alert, sql_runner, api, direct_bigquery"
  }

  dimension: history_slug {
    type: string
    sql: ${TABLE}.history_slug ;;
    label: "Looker History Slug"
    description: "Unique slug linking BigQuery INFORMATION_SCHEMA records to Looker System Activity history"
  }

  dimension: cache_hit {
    type: yesno
    sql: ${TABLE}.cache_hit ;;
    label: "Cache Hit"
    description: "Whether BigQuery served the query from cache (resulting in 0 billed bytes and $0.00 cost)"
  }

  dimension: runtime_seconds {
    type: number
    sql: ${TABLE}.runtime_seconds ;;
    label: "Runtime (Seconds)"
    value_format_name: decimal_2
    description: "Query execution elapsed time in seconds"
  }

  # =================================================================================================
  # MEASURES (Protected against fanout with symmetric aggregation)
  # =================================================================================================
  measure: query_count {
    type: count
    label: "Total Queries"
    description: "Total count of executed BigQuery jobs"
    drill_fields: [job_id, looker_user_name, content_name, query_source, query_time_time, total_cost]
  }

  measure: looker_query_count {
    type: count
    filters: [is_looker_query: "yes"]
    label: "Looker Queries Count"
    description: "Count of queries initiated from the Looker platform"
  }

  measure: total_bytes_billed {
    type: sum
    sql: ${TABLE}.effective_bytes_billed ;;
    label: "Total Bytes Billed"
    value_format_name: decimal_0
    description: "Sum of effective billed bytes, enforcing the BigQuery 10 MB minimum on non-cached queries"
  }

  measure: total_gigabytes_billed {
    type: number
    sql: ${total_bytes_billed} / 1073741824.0 ;;
    label: "Total GB Billed"
    value_format_name: decimal_2
    description: "Total Gigabytes billed (1 GB = 2^30 bytes = 1,073,741,824 bytes)"
  }

  measure: total_terabytes_billed {
    type: number
    sql: ${total_bytes_billed} / 1099511627776.0 ;;
    label: "Total TB Billed"
    value_format_name: decimal_3
    description: "Total Terabytes billed (1 TB = 2^40 bytes = 1,099,511,627,776 bytes)"
  }

  measure: total_cost {
    type: number
    sql: ${total_terabytes_billed} * {% parameter cost_per_tb_rate %} ;;
    label: "Total Gross Cost ($)"
    value_format: "$#,##0.00"
    description: "Gross Query Cost calculated as (Total Terabytes Billed * On-Demand Rate per TB)"
    drill_fields: [job_id, looker_user_name, content_name, explore_name, query_time_time, total_cost]
  }

  measure: net_cost_with_free_tier {
    type: number
    sql: GREATEST(0.0, ${total_cost} - {% parameter cost_per_tb_rate %}) ;;
    label: "Total Net Cost (w/ Free Tier) ($)"
    value_format: "$#,##0.00"
    description: "Net monthly query cost factoring in Google Cloud's 1 TB/month free tier credit ($6.25/month credit)"
  }

  measure: average_cost_per_query {
    type: number
    sql: ${total_cost} / NULLIF(${query_count}, 0) ;;
    label: "Avg Cost per Query ($)"
    value_format: "$#,##0.0000"
    description: "Average cost per query execution"
  }

  measure: max_query_cost {
    type: max
    sql: (${TABLE}.effective_bytes_billed / 1099511627776.0) * {% parameter cost_per_tb_rate %} ;;
    label: "Max Query Cost ($)"
    value_format: "$#,##0.00"
    description: "Maximum single query cost within the filtered period"
  }

  measure: cache_hit_count {
    type: count
    filters: [cache_hit: "yes"]
    label: "Cached Queries Count"
    description: "Number of queries served from BigQuery cache at $0.00 cost"
  }

  measure: cache_hit_rate {
    type: number
    sql: ${cache_hit_count} / NULLIF(${query_count}, 0) ;;
    label: "Cache Hit Rate"
    value_format_name: percent_1
    description: "Percentage of queries served from cache (costing $0.00)"
  }

  measure: active_users_count {
    type: count_distinct
    sql: ${TABLE}.looker_user_name ;;
    label: "Active Querying Users"
    description: "Count of distinct active users or service accounts executing queries"
    drill_fields: [looker_user_name, total_cost, query_count]
  }

  measure: active_dashboards_count {
    type: count_distinct
    sql: ${TABLE}.dashboard_id ;;
    label: "Active Dashboards"
    description: "Count of distinct dashboards queried within the timeframe"
    drill_fields: [dashboard_title, total_cost, query_count]
  }

  measure: avg_runtime_seconds {
    type: average
    sql: ${TABLE}.runtime_seconds ;;
    label: "Avg Runtime (sec)"
    value_format_name: decimal_2
    description: "Average query execution latency in seconds"
  }

  measure: total_slot_hours {
    type: sum
    sql: ${TABLE}.total_slot_ms / 3600000.0 ;;
    label: "Total Slot Hours"
    value_format_name: decimal_2
    description: "Total BigQuery compute slot hours consumed"
  }
}
